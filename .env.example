# ============================================================
# ROCCMACH — variables de entorno
# ============================================================
# Desarrollo local:
#   cp .env.example .env.local
#   (y llena los valores reales — .env.local nunca se sube a git)
#
# Producción:
#   Vercel → proyecto roccmach → Settings → Environment Variables
#   Después de agregar o cambiar una variable ahí, hace falta un
#   REDEPLOY para que se aplique (un deploy ya construido no la
#   recoge solo — Deployments → ⋯ → Redeploy, o un nuevo push).
# ============================================================


# ---------- Sanity (CMS del sitio) ----------
# manage.sanity.io → tu proyecto → Settings → API

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Token con permiso "Editor" (manage.sanity.io → API → Tokens → Add API token).
# Sin esto el sitio puede LEER contenido pero no puede crear pedidos ni leads.
SANITY_WRITE_TOKEN=

# Debe ser EXACTAMENTE igual al ?secret=... configurado en el webhook de Sanity
# (manage.sanity.io → API → Webhooks). Protege /api/notify: sin este valor (o si
# no coincide), el endpoint rechaza todo con 401 — así se diseñó a propósito,
# nunca debe quedar abierto. Genera un valor random y largo, no algo memorable.
SANITY_WEBHOOK_SECRET=


# ---------- Mercado Pago (cobros) ----------
# www.mercadopago.com.mx/developers/panel/app → Credenciales

# TEST-... = modo sandbox/pruebas. APP_USR-... = modo producción, cobra dinero real.
MP_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=


# ---------- Resend (correos transaccionales) ----------
# resend.com → API Keys → Create

RESEND_API_KEY=

# Remitente de los correos (confirmaciones, cotizaciones, cambios de estatus).
# Requiere verificar un dominio propio primero en resend.com → Domains — mientras
# no esté verificado, el sitio cae solo a un remitente de pruebas y no falla.
RESEND_FROM="ROCCMACH <pedidos@tudominio.mx>"


# ---------- General del sitio ----------

# Número de WhatsApp de ventas, formato internacional sin signos (52...).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Dominio público real del sitio, SIN slash al final (ej. https://roccmach.com.mx).
# Se usa para los links de los correos, el regreso de pago de Mercado Pago, el
# sitemap y el SEO. En local puede quedarse en http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
